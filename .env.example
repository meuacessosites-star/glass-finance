# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Select "firebase" only after configuring Firebase and testing with a non-production Convex deployment.
# Leave blank (or use "convex") to retain the current sign-in provider.
VITE_AUTH_PROVIDER=

# Public Firebase Web App configuration (never put a service-account private key here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Used by Convex auth.config.ts while publishing the Convex deployment.
# Vercel Preview currently builds only the frontend; see docs/PRODUCTION_AUTH_AND_SYNC.md.
FIREBASE_PROJECT_ID=
