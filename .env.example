# Client URL for a local Vite build or a Vercel preview.
# Production on Vercel sets this during convex deploy.
VITE_CONVEX_URL=

# Optional deployment selector for local Convex CLI commands.
CONVEX_DEPLOYMENT=

# Production OAuth, email delivery and signing keys live on the Convex deployment.
# See docs/PRODUCTION_AUTH_AND_SYNC.md for the dashboard settings.
